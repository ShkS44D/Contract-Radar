CONTRACT_RADAR_ENV=development
# Required long random value in production (at least 32 characters).
SECRET_KEY=
CONTRACT_RADAR_DATA_DIR=.contract-radar
CONTRACT_RADAR_SCAN_TIMEOUT=120
CONTRACT_RADAR_COMPILER_TIMEOUT=120
CONTRACT_RADAR_DEFAULT_COMPILER=0.8.30
CONTRACT_RADAR_OFFLINE=false
CONTRACT_RADAR_WORKERS=2
CONTRACT_RADAR_QUEUE_SIZE=4
CONTRACT_RADAR_RETENTION_HOURS=24
CONTRACT_RADAR_MAX_UPLOAD_MB=2
CONTRACT_RADAR_MAX_EXTRACTED_MB=8
CONTRACT_RADAR_MAX_FILES=50
CONTRACT_RADAR_RATE_LIMIT=10 per minute
CONTRACT_RADAR_COOKIE_SECURE=false
CONTRACT_RADAR_DEBUG=false
