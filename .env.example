SENTINEL_ENV=development
# Required long random value in production (at least 32 characters).
SECRET_KEY=
SENTINEL_DATA_DIR=.sentinel
SENTINEL_SCAN_TIMEOUT=120
SENTINEL_COMPILER_TIMEOUT=120
SENTINEL_DEFAULT_COMPILER=0.8.30
SENTINEL_OFFLINE=false
SENTINEL_WORKERS=2
SENTINEL_QUEUE_SIZE=4
SENTINEL_RETENTION_HOURS=24
SENTINEL_MAX_UPLOAD_MB=2
SENTINEL_MAX_EXTRACTED_MB=8
SENTINEL_MAX_FILES=50
SENTINEL_RATE_LIMIT=10 per minute
SENTINEL_COOKIE_SECURE=false
SENTINEL_DEBUG=false
